{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "django",
            "runtimeExecutable": ".venv/Scripts/python.exe",
            "runtimeArgs": [
                "manage.py",
                "runserver",
                "8000"
            ],
            "port": 8000
        },
        {
            "name": "showcase",
            "runtimeExecutable": ".venv/Scripts/python.exe",
            "runtimeArgs": [
                "-m",
                "http.server",
                "5500",
                "--bind",
                "127.0.0.1"
            ],
            "port": 5500
        }
    ]
}
