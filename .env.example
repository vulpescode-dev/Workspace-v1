# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a Git.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Para abrirla desde el teléfono (QR de showcase.html) agrega la IP de tu PC, p. ej. ...,192.168.1.50
# y arranca con: python manage.py runserver 0.0.0.0:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Mexico_City
# Base de datos (etapa inicial: SQLite)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Solo para una etapa posterior (PostgreSQL), no necesarios ahora:
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=

# Correo (preparado; la cuenta no-reply@ aún no existe). Vacío = los correos se imprimen en la consola.
# DEFAULT_FROM_EMAIL=Workspace <no-reply@orienta.soy>   # por defecto: no-reply@GOOGLE_ALLOWED_DOMAIN
# SITE_URL=https://workspace.orienta.soy                 # para los enlaces dentro de los correos
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # en desarrollo, para enviar de verdad
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@orienta.soy
# EMAIL_HOST_PASSWORD=                                    # contraseña de aplicación, nunca la personal
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false

# JWT (instalado, aún sin usar; ver config/settings/base.py). Opcionales: valores por defecto.
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
# JWT_SIGNING_KEY=          # vacía = usa DJANGO_SECRET_KEY

# Inicio de sesión con Google (Google Cloud → ID de cliente OAuth, app web, consentimiento «Interna»).
# Vacíos: el botón «Continuar con Google» no funciona. Nunca subas el secreto al repositorio.
GOOGLE_ALLOWED_DOMAIN=orienta.soy
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notificaciones push (PWA): llave pública VAPID. Vacía = push desactivado.
WEBPUSH_VAPID_PUBLIC_KEY=
