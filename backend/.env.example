# ============================================================================
# backend/.env.example — cópialo a backend/.env y ajusta los valores.
# Todo lo que cambia entre equipos o servidores vive aquí, no en los .py.
# ============================================================================

# --- Proyecto ---------------------------------------------------------------
# Nombre visible (API, admin, correos) y código corto (prefijo de cookies y emisor de los JWT).
PROJECT_NAME=Workspace
PROJECT_CODE=ws

# --- Django -----------------------------------------------------------------
# development | production (elige config/settings/<entorno>.py)
DJANGO_ENV=development
# Genérala con: python manage.py runscript scripts.generate_secret_key (después de copiar este archivo)
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Hosts con los que se puede llamar al backend. Para abrir la app desde otro equipo de la red agrega la
# IP de tu PC (p. ej. ...,192.168.1.50) y arranca Vite con «npm run dev -- --host» (ver README, «Correr en
# la red»). El backend puede seguir en localhost; 0.0.0.0:8000 solo para abrir el admin desde otro equipo.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=America/Mexico_City
DJANGO_LANGUAGE_CODE=es

# --- Frontend (React) ---------------------------------------------------------
# Origen donde corre React. En desarrollo Vite reenvía /api al backend (mismo origen, sin CORS).
FRONTEND_URL=http://localhost:5173
# Solo si el frontend vive en OTRO dominio que el backend (separados por coma). Vacío = sin CORS.
CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Base de datos (etapa inicial: SQLite) -----------------------------------
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Solo para una etapa posterior (PostgreSQL):
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=

# --- JWT -------------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Vacía = firma con DJANGO_SECRET_KEY
JWT_SIGNING_KEY=
# Cookie del refresh token: true obligatorio con HTTPS (producción lo activa solo).
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Strict
# Intentos de login por IP
AUTH_THROTTLE_RATE=10/min

# --- Correo (preparado; la cuenta no-reply@ aún no existe) -------------------
# Vacío = los correos se imprimen en la consola del backend.
# DEFAULT_FROM_EMAIL=Workspace <no-reply@orienta.soy>   # por defecto: PROJECT_NAME <no-reply@GOOGLE_ALLOWED_DOMAIN>
# SITE_URL=https://workspace.orienta.soy                 # enlaces dentro de los correos; por defecto FRONTEND_URL
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@orienta.soy
# EMAIL_HOST_PASSWORD=                                    # contraseña de aplicación, nunca la personal
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false

# --- Google (Google Cloud → ID de cliente OAuth, app web, consentimiento «Interna») ----
# La pantalla de React llega en otra tanda; las reglas de dominio ya están en el backend.
GOOGLE_ALLOWED_DOMAIN=orienta.soy
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Notificaciones push (PWA): llave pública VAPID. Vacía = push desactivado ----
WEBPUSH_VAPID_PUBLIC_KEY=
