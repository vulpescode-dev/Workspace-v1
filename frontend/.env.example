# ============================================================================
# frontend/.env.example — cópialo a frontend/.env y ajusta los valores.
# Solo las variables con prefijo VITE_ llegan al navegador: nunca pongas secretos ahí.
# ============================================================================

# --- Proyecto (mismos valores que backend/.env) --------------------------------
VITE_PROJECT_NAME=Workspace
VITE_PROJECT_CODE=ws

# --- API -------------------------------------------------------------------------
# Ruta (mismo origen, recomendado) o URL completa si el backend vive en otro dominio.
VITE_API_URL=/api

# --- Servidor de desarrollo (solo Vite, no llegan al navegador) ------------------
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_PORT=5173
# Hosts extra para abrir Vite desde otro equipo/teléfono (p. ej. 192.168.1.50). Separados por coma.
FRONTEND_ALLOWED_HOSTS=
